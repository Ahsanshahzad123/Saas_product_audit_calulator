<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ── SaaS Audit tab injected into the standard CRM Lead/Opportunity form ── -->
  <record id="crm_lead_form_saas_audit" model="ir.ui.view">
    <field name="name">crm.lead.form.saas.audit</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_all_leads"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="SaaS Audit" name="saas_audit"
              invisible="saas_source != 'saas_audit_calculator'">
          <group>
            <group string="Lead Classification">
              <field name="saas_lead_type" widget="badge"/>
              <field name="saas_opportunity_score"/>
              <field name="saas_verdict"/>
              <field name="saas_team_size"/>
              <field name="saas_ip_address" readonly="1"/>
            </group>
            <group string="Audit Inputs">
              <field name="saas_audience_type"/>
              <field name="saas_type"/>
              <field name="saas_complexity"/>
              <field name="saas_target_users"/>
              <field name="saas_launch_timeline"/>
              <field name="saas_ai_type"/>
              <field name="saas_industry"/>
              <field name="saas_role"/>
            </group>
          </group>
          <group>
            <group string="Financial Inputs">
              <field name="saas_revenue_goal" widget="monetary" options="{'currency_field': 'saas_currency_id'}"/>
              <field name="saas_budget"       widget="monetary" options="{'currency_field': 'saas_currency_id'}"/>
            </group>
            <group string="Audit Results">
              <field name="saas_monthly_rev_lost"  widget="monetary" options="{'currency_field': 'saas_currency_id'}"/>
              <field name="saas_loss_6_months"     widget="monetary" options="{'currency_field': 'saas_currency_id'}"/>
              <field name="saas_loss_12_months"    widget="monetary" options="{'currency_field': 'saas_currency_id'}"/>
              <field name="saas_monthly_build_min" widget="monetary" options="{'currency_field': 'saas_currency_id'}"/>
              <field name="saas_monthly_build_max" widget="monetary" options="{'currency_field': 'saas_currency_id'}"/>
              <field name="saas_total_budget_min"  widget="monetary" options="{'currency_field': 'saas_currency_id'}"/>
              <field name="saas_total_budget_max"  widget="monetary" options="{'currency_field': 'saas_currency_id'}"/>
              <field name="saas_roi_months"/>
              <field name="saas_build_timeline"/>
            </group>
          </group>
          <group string="Challenge">
            <field name="saas_challenge" nolabel="1" colspan="2"/>
          </group>
          <!-- hidden currency field needed by monetary widgets -->
          <field name="saas_currency_id" invisible="1"/>
        </page>
      </xpath>
    </field>
  </record>

  <!-- ── Dedicated list view for SaaS calculator leads ── -->
  <record id="saas_audit_crm_lead_list" model="ir.ui.view">
    <field name="name">saas.audit.crm.lead.list</field>
    <field name="model">crm.lead</field>
    <field name="arch" type="xml">
      <list string="SaaS Audit Leads"
            decoration-success="saas_opportunity_score &gt;= 60"
            decoration-warning="saas_opportunity_score &gt;= 40 and saas_opportunity_score &lt; 60"
            decoration-danger="saas_opportunity_score &lt; 40">
        <field name="create_date" string="Submitted"/>
        <field name="partner_name" string="Name"/>
        <field name="email_from"   string="Email"/>
        <field name="phone"/>
        <field name="saas_lead_type"
               widget="badge"
               decoration-info="saas_lead_type == 'calculator'"
               decoration-success="saas_lead_type == 'audit_request'"
               string="Type"/>
        <field name="saas_audience_type"    string="Audience"/>
        <field name="saas_type"             string="Product Type"/>
        <field name="saas_opportunity_score" string="Score"/>
        <field name="saas_verdict"           string="Verdict"/>
        <field name="saas_revenue_goal"      string="Rev Goal/Yr" widget="monetary"
               options="{'currency_field': 'saas_currency_id'}"/>
        <field name="saas_loss_12_months"    string="12-Mo Risk"  widget="monetary"
               options="{'currency_field': 'saas_currency_id'}"/>
        <field name="saas_currency_id" column_invisible="1"/>
        <field name="priority" widget="priority"/>
        <field name="stage_id"/>
      </list>
    </field>
  </record>

  <!-- ── Search view for SaaS calculator leads ── -->
  <record id="saas_audit_crm_lead_search" model="ir.ui.view">
    <field name="name">saas.audit.crm.lead.search</field>
    <field name="model">crm.lead</field>
    <field name="arch" type="xml">
      <search string="Search SaaS Audit Leads">
        <field name="email_from" string="Email"/>
        <field name="partner_name" string="Name"/>
        <filter string="Calculator Results" name="calculator"
                domain="[('saas_lead_type','=','calculator')]"/>
        <filter string="Audit Requests"     name="audit_request"
                domain="[('saas_lead_type','=','audit_request')]"/>
        <separator/>
        <filter string="Score ≥ 80 (Strong)"  name="strong"   domain="[('saas_opportunity_score','&gt;=',80)]"/>
        <filter string="Score ≥ 60 (Good)"    name="good"     domain="[('saas_opportunity_score','&gt;=',60),('saas_opportunity_score','&lt;',80)]"/>
        <filter string="Score &lt; 40 (Risky)" name="risky"   domain="[('saas_opportunity_score','&lt;',40)]"/>
        <separator/>
        <group expand="0" string="Group By">
          <filter string="Lead Type"     name="by_type"     context="{'group_by':'saas_lead_type'}"/>
          <filter string="Audience Type" name="by_audience" context="{'group_by':'saas_audience_type'}"/>
          <filter string="SaaS Type"     name="by_saas"     context="{'group_by':'saas_type'}"/>
          <filter string="Stage"         name="by_stage"    context="{'group_by':'stage_id'}"/>
          <filter string="Month"         name="by_month"    context="{'group_by':'create_date:month'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- ── Window action — shows only SaaS calculator leads ── -->
  <record id="saas_audit_crm_lead_action" model="ir.actions.act_window">
    <field name="name">SaaS Audit Leads</field>
    <field name="res_model">crm.lead</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('saas_source','=','saas_audit_calculator')]</field>
    <field name="view_ids" eval="[
      (5, 0, 0),
      (0, 0, {'view_mode': 'list', 'view_id': ref('saas_audit_crm_lead_list')}),
      (0, 0, {'view_mode': 'form', 'view_id': ref('crm.crm_lead_all_leads')}),
    ]"/>
    <field name="search_view_id" ref="saas_audit_crm_lead_search"/>
    <field name="context">{'search_default_audit_request': 0}</field>
  </record>

</odoo>
